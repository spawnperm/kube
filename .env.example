# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# GEMINI_MODEL: Model used by the Kubik AI-orchestrator.
GEMINI_MODEL="gemini-3.8-flash"

# GEMINI_TIMEOUT_MS: Per-request timeout for Gemini (ms).
GEMINI_TIMEOUT_MS=30000

# GEMINI_MAX_RETRIES: Retries with exponential backoff on 429/503/timeouts.
GEMINI_MAX_RETRIES=3

# PORT: HTTP port for the Express server.
PORT=3000

# CORS_ORIGINS: Comma-separated allow-list of origins. Empty for dev mode.
CORS_ORIGINS=""

# BODY_LIMIT: Maximum JSON body size accepted by the API.
BODY_LIMIT="2mb"

# SYNC_TOKEN_SECRET: Salt for room sync tokens.
SYNC_TOKEN_SECRET=""

# LOG_LEVEL: pino log level (trace|debug|info|warn|error).
LOG_LEVEL="info"
